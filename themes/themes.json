            },
            {
                "type": "select",
                "var": "--mz-indent",
                "label": "首行缩进",
                "default": "0",
                "choices": [
                    [
                        "0",
                        "不缩进"
                    ],
                    [
                        "2em",
                        "两个字"
                    ]
                ]
            },
            {
                "type": "select",
                "var": "--mz-initial-size",
                "label": "首字抬升",
                "default": "2",
                "choices": [
                    [
                        "2",
                        "两行高"
                    ],
                    [
                        "0",
                        "关闭"
                    ]
                ]
            },
            {
                "type": "head",
                "label": "文字"
            },
            {
                "type": "text",
                "var": "--mz-opening-label",
                "label": "开篇小标题",
                "default": "Opening"
            },
            {
                "type": "text",
                "var": "--mz-end-mark",
                "label": "文末符",
                "default": "■"
