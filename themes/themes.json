                    },
                    {
                        "value": "铂钯印相",
                        "label": "铂钯印相",
                        "css": "html:root:root {\n    --yy-tone: '铂钯印相';\n    --yy-z0: #1A1815;\n    --yy-z1: #2E2923;\n    --yy-z2: #433B32;\n    --yy-z3: #594F42;\n    --yy-z4: #6F6355;\n    --yy-z5: #867969;\n    --yy-z6: #9C8F80;\n    --yy-z7: #B2A698;\n    --yy-z8: #C8BEB2;\n    --yy-z9: #DDD6CF;\n    --yy-z10: #F3EFEB;\n}\nhtml.dn-night:root:root { --SmartThemeBodyColor: rgba(200, 190, 178, 1) !important; --SmartThemeEmColor: rgba(156, 143, 128, 1) !important; --SmartThemeQuoteColor: rgba(221, 214, 207, 1) !important; --SmartThemeBlurTintColor: rgba(46, 41, 35, 1) !important; --SmartThemeChatTintColor: rgba(46, 41, 35, 1) !important; --SmartThemeBorderColor: rgba(89, 79, 66, 1) !important; --SmartThemeShadowColor: rgba(26, 24, 21, 0.6) !important; }"
                    },
                    {
                        "value": "氰版蓝晒",
                        "label": "氰版蓝晒",
                        "css": "html:root:root {\n    --yy-tone: '氰版蓝晒';\n    --yy-z0: #070C11;\n    --yy-z1: #131E2A;\n    --yy-z2: #203346;\n    --yy-z3: #2F4862;\n    --yy-z4: #425F7D;\n    --yy-z5: #587797;\n    --yy-z6: #708FAF;\n    --yy-z7: #8CA8C6;\n    --yy-z8: #AAC1D9;\n    --yy-z9: #CCDAEA;\n    --yy-z10: #ECF4FD;\n}\nhtml.dn-night:root:root { --SmartThemeBodyColor: rgba(170, 193, 217, 1) !important; --SmartThemeEmColor: rgba(112, 143, 175, 1) !important; --SmartThemeQuoteColor: rgba(204, 218, 234, 1) !important; --SmartThemeBlurTintColor: rgba(19, 30, 42, 1) !important; --SmartThemeChatTintColor: rgba(19, 30, 42, 1) !important; --SmartThemeBorderColor: rgba(47, 72, 98, 1) !important; --SmartThemeShadowColor: rgba(7, 12, 17, 0.6) !important; }"
