                    [
                        "var(--mz-sans)",
                        "黑体"
                    ],
                    [
                        "var(--mz-serif)",
                        "宋体（和角色一样）"
                    ]
                ]
            },
            {
                "type": "select",
                "var": "--mz-em-style",
                "label": "旁白",
                "default": "normal",
                "choices": [
                    [
                        "normal",
                        "不倾斜"
                    ],
                    [
                        "italic",
                        "倾斜"
                    ]
                ]
            },
            {
                "type": "select",
                "var": "--mz-day-desk",
                "label": "昼版两侧桌面",
                "default": "12%",
                "choices": [
                    [
                        "12%",
                        "压暗"
                    ],
                    [
                        "0%",
                        "不压暗"
                    ]
