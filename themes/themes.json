    {
        "family": "粗野指北",
        "version": "1.0.3",
        "variantLabel": "变体",
        "options": [
            {
                "type": "head",
                "label": "墙和聊天栏"
            },
            {
                "type": "select",
                "var": "--ds-bg",
                "label": "背景",
                "default": "concrete",
                "note": "在顶栏「背景」面板里点一张图，会自动切到「酒馆背景图」",
                "choices": [
                    [
                        "concrete",
                        "混凝土墙"
                    ],
                    [
                        "image",
                        "酒馆背景图"
                    ]
                ],
                "onBackgroundPick": "image"
            },
            {
                "key": "concrete",
                "type": "select",
                "label": "墙面",
                "choices": [
                    {
                        "value": "hammer",
                        "label": "锤凿面（画的）"
                    },
                    {
                        "value": "fine",
                        "label": "细砂面（画的，更安静）",
                        "css": "html:root:root { --ds-concrete: var(--ds-concrete-fine); --ds-concrete-size: 300px; }"
                    },
                    {
                        "value": "photo-hammer",
                        "label": "照片 · 粗骨料特写",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.62); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/hammer.jpg\") 0 0 / 700px repeat; }"
                    },
                    {
                        "value": "photo-warm",
                        "label": "照片 · 暖灰锤凿墙",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.55); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/warm.jpg\") 0 0 / 480px repeat; }"
                    },
                    {
                        "value": "photo-pebble",
                        "label": "照片 · 灰色细卵石",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.45); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/pebble.jpg\") 0 0 / 520px repeat; }"
                    },
                    {
                        "value": "photo-vents",
                        "label": "照片 · 日照骨料",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.72); --ds-day-photo-lift: #1C1B19; --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/vents.jpg\") 0 0 / 400px repeat; }"
                    },
                    {
                        "value": "photo-phone",
                        "label": "照片 · 暖灰粗骨料",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.5); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/phone.jpg\") 0 0 / 760px repeat; }"
                    },
                    {
                        "value": "photo-hammer-big",
                        "label": "照片 · 粗骨料特写（放大）",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.62); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/hammer-big.jpg\") center / cover no-repeat; }"
                    },
                    {
                        "value": "photo-warm-big",
                        "label": "照片 · 暖灰锤凿墙（放大）",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.55); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/warm-big.jpg\") center / cover no-repeat; }"
                    },
                    {
                        "value": "photo-phone-big",
                        "label": "照片 · 暖灰粗骨料（放大）",
                        "css": "html:root:root { --ds-photo-dim: rgba(22, 21, 20, 0.5); --ds-wall-bg: linear-gradient(var(--ds-photo-dim), var(--ds-photo-dim)), var(--ds-wall) url(\"{EXT}assets/daoshi/phone-big.jpg\") center / cover no-repeat; }"
                    }
                ],
                "note": "「照片」是巴比肯实拍的混凝土：不带括号的是原尺寸无缝贴图，「放大」是一整张铺满。照片作者：George Rex（CC BY-SA 2.0）、Sandiooses（CC BY-SA 3.0）、failing_angel、Simon Aughton、King....（均为 CC BY-NC-SA 2.0），详见扩展里的 assets/daoshi/CREDITS.md"
